FROM ruby:3.1.7-slim-bookworm

WORKDIR /usr/src/app

COPY Gemfile Gemfile.lock /usr/src/app/

RUN apt-get update && \
    apt-get install -y build-essential cron libcurl4-openssl-dev libxml2-dev && \
    apt-get install -y wget ca-certificates zlib1g-dev && \
    wget --quiet -O /etc/apt/trusted.gpg.d/mariadb.asc https://mariadb.org/mariadb_release_signing_key.pgp && \
    echo 'deb https://dlm.mariadb.com/repo/mariadb-server/12.3/repo/debian bookworm main' > /etc/apt/sources.list.d/mariadb.list && \
    apt-get update && \
    apt-get install -y mariadb-client && \
    printf '#!/bin/sh\nexec mariadb-dump "$@"\n' > /usr/local/bin/mysqldump && \
    chmod +x /usr/local/bin/mysqldump && \
    apt-get remove -y wget && \
    mysqldump --version && \
    bundle config set force_ruby_platform true && \
    gem install bundler -v "~> 2.0" && \
    bundle install && \
    apt-get remove -y build-essential && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

COPY fs/ /

ENV BACKUP_DATA_PATH="/var/lib/backups" \
    BACKUP_TMP_PATH="/tmp/backup" \
    RUBYOPT="-r/usr/local/lib/ruby-psych-compat.rb"

STOPSIGNAL SIGKILL

ENTRYPOINT [ "/usr/local/bin/entrypoint.sh" ]
